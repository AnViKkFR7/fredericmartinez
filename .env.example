# Copia este archivo a .env y rellena los valores

SESSION_SECRET=change_me
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Integraciones Moira Ordo: instancia del panel (puede diferir del CMS)
SUPABASE_URL=https://tu-panel.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Pública, obligatoria en servidor y build; sin UUID válido se rechazan nuevas solicitudes.
VITE_COMPANY_ID=40e02f2e-8863-4d3a-9bc8-352223d9aab0
# Secreto aleatorio distinto por entorno, solo servidor
ANALYTICS_SALT=

# Aviso por correo opcional; una solicitud se guarda aunque falle SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Dominio canónico para el blog y sitemap (sin barra final)
PUBLIC_SITE_URL=https://fredericmartinez.com
